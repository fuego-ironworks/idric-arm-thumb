module CheckBoundaries

import Data.String
import System
import System.Directory
import System.File

-- This helper implements the pinned historical compiler's Idris compatibility
-- interface. System.run fixes the host process/capture boundary; escapeCmd
-- protects every argv element before the fixed stderr capture is appended.
%default covering

run_compiler : String -> String -> String -> String -> IO (String, Int)
run_compiler driver source_directory source_file output_name =
  System.run (escapeCmd [driver, "--cg", "arm-thumb", "--source-dir",
                        source_directory, source_file, "-o", output_name]
              ++ " 2>&1")

require_rejection : String -> String -> String -> List String -> IO ()
require_rejection driver fixture output_name diagnostics = do
  let directory = "examples/autogenerated/signed-fp8-boundary"
  let assembly = "build/exec/" ++ output_name ++ ".arm-thumb.S"
  _ <- removeFile assembly
  (output, status) <- run_compiler driver directory
                                 (directory ++ "/" ++ fixture) output_name
  if status == 0
    then die ("FAIL: compiler accepted " ++ fixture ++ "\n" ++ output)
    else pure ()
  if all (`isInfixOf` output) diagnostics
    then pure ()
    else die ("FAIL: wrong rejection for " ++ fixture ++ "\n" ++ output)
  generated <- exists assembly
  if generated
    then die ("FAIL: rejected source emitted " ++ assembly)
    else putStrLn ("PASS: rejected " ++ fixture ++ " for its intended type error")

main : IO ()
main = do
  [_, repository_root, driver] <- getArgs
    | _ => die "usage: check-signed-fp8-boundaries ABSOLUTE_REPOSITORY ABSOLUTE_DRIVER"
  changed <- changeDir repository_root
  if changed then pure () else die "FAIL: cannot enter the specified repository"
  (output, status) <- run_compiler driver "examples" "examples/Scalars.idric"
                                 "signed-fp8-positive-control"
  if status == 0
    then putStrLn "PASS: checked signed FP8 and explicit Ootomo storage source"
    else die ("FAIL: positive source control\n" ++ output)
  require_rejection driver "RejectAmbiguousE5M3.idric" "reject-ambiguous-e5m3"
    ["arm-thumb rejected source ABI", "ambiguous E5M3 source type"]
  require_rejection driver "RejectFP8Swap.idric" "reject-fp8-swap"
    ["Mismatch between", "E4M3", "E5M2"]
  require_rejection driver "RejectStorageAsFP8.idric" "reject-storage-as-fp8"
    ["Mismatch between", "E4M3", "OotomoE5M3"]
